__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
*.whl
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Distribution / packaging
dist/
build/
eggs/
*.tar.gz
*.zip
wheels/
MANIFEST

# Installer logs
pip-log.txt
pip-install-log.txt

