# Same-origin API base. The Next dev server proxies /api/v1/* to the backend
# (see next.config.js rewrites); production serves the app and API through the
# gateway at the same origin. Override with the full backend URL when calling
# cross-origin (e.g. http://localhost:8000/api/v1 for direct tooling).
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Tenant slug for local dev when the Host header has no tenant subdomain
# (e.g. plain localhost:3000 instead of acme.localhost:3000). The value must be
# a real provisioned tenant — reserved platform slugs (web, app, acme, ...) are
# rejected by the identity service. Server-side: TENANT_SLUG; browser-side:
# NEXT_PUBLIC_TENANT_SLUG.
TENANT_SLUG=
NEXT_PUBLIC_TENANT_SLUG=
