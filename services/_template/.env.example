# {NAME} Service Environment Variables
# Copy to .env and fill in values.
# Prefix: {NAME}_ (uppercase service name)

# --- Environment ---
{NAME}_ENVIRONMENT=dev
{NAME}_DEBUG=true

# --- Database (REQUIRED) ---
{NAME}_DATABASE_URL=postgresql+asyncpg://skyrict:skyrict@localhost:5432/skyrict_{name}

# --- Redis (REQUIRED) ---
{NAME}_REDIS_URL=redis://localhost:6379/0

# --- JWT RS256 (REQUIRED — all four must be set) ---
# Generate keys: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#                openssl rsa -pubout -in private.pem -out public.pem
{NAME}_JWT_PRIVATE_KEY_PATH=./tests/fixtures/rsa/private.pem
{NAME}_JWT_PUBLIC_KEY_PATH=./tests/fixtures/rsa/public.pem
{NAME}_JWKS_ISSUER=https://auth.skyrict.io
{NAME}_JWKS_AUDIENCE=api.skyrict.io
{NAME}_ACCESS_TOKEN_EXPIRE_MINUTES=30
{NAME}_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
{NAME}_CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
{NAME}_LOG_LEVEL=INFO
{NAME}_LOG_JSON=false

# --- Multi-tenancy ---
{NAME}_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
