# ===========================================
# AI Agent Service (services/ai-agent)
# Copy to .env and fill in values
# ===========================================

AI_ENVIRONMENT=dev
AI_DEBUG=true
AI_LOG_LEVEL=INFO
AI_LOG_JSON=false

# --- Database (REQUIRED) ---
# Shares the skyrict_identity Postgres database with identity/core;
# this service migrates under its own alembic_version_ai table.
AI_DATABASE_URL=postgresql+asyncpg://skyrict:skyrict@localhost:5433/skyrict_identity

# --- Redis (REQUIRED - distributed rate limiting) ---
AI_REDIS_URL=redis://localhost:6379/0

# --- JWT verification (REQUIRED - same public key/issuer/audience as core) ---
AI_JWT_PUBLIC_KEY_PATH=./.dev/keys/public.pem
AI_JWKS_ISSUER=https://auth.skyrict.io
AI_JWKS_AUDIENCE=api.skyrict.io

AI_CORS_ORIGINS=["http://localhost:3000"]

# Tenant subdomain base domain - required in staging/production; ignored in
# dev/test where nginx injects X-Tenant-Slug.
AI_BASE_DOMAIN=

# --- Core (inventory) service ---
# Compose contract uses the UNPREFIXED variable name (spec section 6.4).
# NOTE: the core container serves on port 8001 internally.
INVENTORY_SERVICE_URL=http://localhost:8001

# --- AI providers (ALL optional - provider-agnostic boot) ---
# With no provider configured the service boots; AI requests return typed
# 503 ai_unavailable. Provider keys resolve via the registry presets:
#   openrouter | groq | openai | omniroute | agentrouter | generic
# omniroute / agentrouter / generic REQUIRE an explicit base URL.
#
# Primary provider:
#AI_PROVIDER=openrouter
#AI_MODEL=meta-llama/llama-3-8b-instruct
#AI_BASE_URL=
#AI_API_KEY=
# Data-residency clearance: True ONLY for providers inside the trust boundary.
# Cloud providers must keep this False - local-only data classes
# (cost/sell prices, customer/supplier names, user IDs) never leave.
#AI_PROVIDER_LOCAL_ONLY=false
#
# Fallback provider:
#AI_FALLBACK_PROVIDER=groq
#AI_FALLBACK_MODEL=llama-3-8b-8192
#AI_FALLBACK_BASE_URL=
#AI_FALLBACK_API_KEY=
#AI_FALLBACK_LOCAL_ONLY=false

# --- AI behaviour ---
AI_PROVIDER_TIMEOUT_SECONDS=20
AI_CONFIDENCE_THRESHOLD=0.75
AI_SUGGESTION_EXPIRY_DAYS=7
AI_ANOMALY_AUTO_CLOSE_DAYS=30

# --- Embeddings (SKY-58 RAG) ---
# Primary: OpenAI text-embedding-3-small at 512d (Matryoshka). Requires the
# API key. Ollama (nomic-embed-text) is EXPERIMENTAL: it emits 768d vectors,
# which need the ai_rag_chunks.embedding column re-migrated to Vector(768).
#AI_EMBEDDING_PROVIDER=openai
#AI_EMBEDDING_MODEL=text-embedding-3-small
#AI_EMBEDDING_DIMENSIONS=512
#AI_EMBEDDING_BASE_URL=
#AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BATCH_SIZE=100
AI_EMBEDDING_TIMEOUT_SECONDS=30

# Bearer token used by `ai-agent ingest --source module` to pull whitelisted
# module data from the core service. Never logged.
#AI_INGEST_TOKEN=

# --- RAG chunking / retrieval (SKY-58) ---
AI_RAG_CHUNK_CHILD_TOKENS=400
AI_RAG_CHUNK_PARENT_TOKENS=2000
AI_RAG_CHUNK_OVERLAP_TOKENS=60
AI_RAG_TOP_K_RETRIEVE=20
AI_RAG_TOP_K_RETURN=5
AI_RAG_CACHE_TTL_SECONDS=3600
AI_RAG_EPISODIC_TTL_DAYS=90

# --- Rate limits (spec 5.4) ---
AI_RATE_LIMIT_NL_QUERY_PER_MIN=30
AI_RATE_LIMIT_RAG_SEARCH_PER_MIN=30
AI_RATE_LIMIT_APPROVAL_PER_MIN=10
AI_RATE_LIMIT_ANOMALY_REVIEW_PER_MIN=10
AI_RATE_LIMIT_TENANT_PER_MIN=100
AI_RATE_LIMIT_SCAN_PER_HOUR=1
AI_RATE_LIMIT_FAIL_CLOSED=false
