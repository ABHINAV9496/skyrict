# Identity Service Environment Variables
# Copy to .env and fill in values.
# Prefix: IDENTITY_ (uppercase)
#
# IMPORTANT: These are LOCAL DEV defaults. Staging and production values
# are injected by Kubernetes from per-environment Secrets — never from
# a committed .env file. See infra/k8s/overlays/{env}/ for the real configs.

# --- Environment (dev-only defaults) ---
IDENTITY_ENVIRONMENT=dev
IDENTITY_DEBUG=true
IDENTITY_LOG_LEVEL=DEBUG
IDENTITY_LOG_JSON=false

# --- Database (REQUIRED) ---
IDENTITY_DATABASE_URL=postgresql+asyncpg://skyrict:Skyrict%4011419@localhost:5432/skyrict_identity

# --- Redis (REQUIRED) ---
IDENTITY_REDIS_URL=redis://localhost:6379/0

# --- JWT RS256 (REQUIRED — all four must be set) ---
# Local dev only: run `uv run python -m skyrict_testing.generate_keys`
# to create gitignored keys at .dev/keys/.
# Or: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#     openssl rsa -pubout -in private.pem -out public.pem
# Tests generate ephemeral keys automatically — never commit key material.
IDENTITY_JWT_PRIVATE_KEY_PATH=./.dev/keys/private.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=./.dev/keys/public.pem
IDENTITY_JWKS_ISSUER=https://auth.skyrict.io
IDENTITY_JWKS_AUDIENCE=api.skyrict.io
IDENTITY_ACCESS_TOKEN_EXPIRE_MINUTES=15
IDENTITY_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (explicit origins only — wildcard '*' forbidden in staging/production) ---
IDENTITY_CORS_ORIGINS=["http://localhost:3000"]

# --- Multi-tenancy ---
IDENTITY_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Tenant subdomain base domain — the first label of <tenant>.BASE_DOMAIN is the
# tenant slug (e.g. acme.skyrict.com -> acme). REQUIRED in staging/production;
# ignored in dev/test where nginx injects X-Tenant-Slug (see infra/nginx/dev.conf).
IDENTITY_BASE_DOMAIN=skyrict.com

# --- Client IP / trusted proxies ---
# Comma-separated IP addresses or CIDR blocks of reverse proxies (e.g. nginx,
# cloud LB) that may inject X-Forwarded-For. When set, the real client IP is
# taken from the rightmost X-Forwarded-For entry that is NOT a trusted hop;
# any X-Forwarded-For is ignored entirely unless the direct TCP peer is itself
# trusted — so clients can never spoof their IP. Leave EMPTY to always record
# the direct TCP peer (correct for direct internet exposure or when an external
# gateway already strips untrusted headers). In Kubernetes set this to the
# node/pod CIDRs or the ingress controller pod CIDR (see infra/k8s/overlays/).
IDENTITY_TRUSTED_PROXIES=

# --- Rate limiting ---
IDENTITY_RATE_LIMIT_LOGIN=5
IDENTITY_RATE_LIMIT_WINDOW_SECONDS=300

# --- MFA (REQUIRED) ---
# Fernet key used to encrypt TOTP secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_MFA_ENCRYPTION_KEY=
# Issuer name embedded in TOTP QR provisioning URIs.
IDENTITY_MFA_TOTP_ISSUER=Skyrict
